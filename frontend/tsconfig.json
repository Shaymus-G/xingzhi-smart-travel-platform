{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["@dcloudio/types", "@uni-helper/uni-app-types"]
  },
  "include": [
    "src/*.ts",
    "src/*.vue",
    "src/*.d.ts",
    "src/pages/**/*.vue",
    "src/api/**/*.ts",
    "src/components/**/*.vue",
    "src/config/**/*.ts",
    "src/types/**/*.ts",
    "src/stores/**/*.ts",
    "src/utils/**/*.ts",
    "src/styles/**/*.scss",
    "env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "unpackage"]
}
