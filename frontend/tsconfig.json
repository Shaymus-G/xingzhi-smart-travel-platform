{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["@dcloudio/types", "@uni-helper/uni-app-types"]
  },
  "include": [
    "*.ts",
    "*.vue",
    "*.d.ts",
    "pages/**/*.vue",
    "api/**/*.ts",
    "types/**/*.ts",
    "stores/**/*.ts",
    "components/**/*.vue",
    "utils/**/*.ts",
    "styles/**/*.scss"
  ],
  "exclude": ["node_modules", "dist", "unpackage"]
}
