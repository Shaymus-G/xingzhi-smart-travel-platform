# ============================================================
# API Keys 配置
# ============================================================

# 高德地图 Web服务 API Key
# 访问 https://lbs.amap.com/ 注册获取
AMAP_API_KEY=your_amap_api_key_here

# 百度地图 API AK
# 访问 https://lbsyun.baidu.com/ 注册获取
BAIDU_MAP_AK=your_baidu_map_ak_here

# Pixabay API Key
# 访问 https://pixabay.com/api/docs/ 注册获取
PIXABAY_API_KEY=your_pixabay_api_key_here

# ============================================================
# 数据库配置
# ============================================================

# 数据库类型: sqlite（开发测试）或 mysql（生产环境）
XINGZHI_DB_TYPE=sqlite

# MySQL 配置（当 DB_TYPE = mysql 时使用）
XINGZHI_DB_HOST=localhost
XINGZHI_DB_PORT=3306
XINGZHI_DB_USER=root
XINGZHI_DB_PASSWORD=
XINGZHI_DB_NAME=xingzhi
